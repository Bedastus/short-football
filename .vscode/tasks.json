{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/short football"
  },
  "presentation": {
    "echo": false,
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "0. START (Windows one-click)",
      "type": "shell",
      "command": "./start.bat",
      "windows": {
        "command": ".\\start.bat"
      },
      "linux": {
        "command": "python3 sokaligi_bot.py run"
      },
      "osx": {
        "command": "python3 sokaligi_bot.py run"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "focus": true
      },
      "detail": "Sets the ladder up on first run, then goes straight into the round loop."
    },
    {
      "label": "1. Open 3 account browsers",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "open_books.py",
        "--accounts",
        "3",
        "--screen",
        "${input:screen}"
      ],
      "problemMatcher": [],
      "detail": "Three isolated browser profiles, tiled left to right in account order."
    },
    {
      "label": "2. Init ladder (base 200, 5 stages)",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_bot.py",
        "init",
        "--bankroll",
        "${input:bankroll}",
        "--base",
        "${input:base}",
        "--stages",
        "5",
        "--step",
        "100",
        "--feed",
        "shared",
        "--books",
        "soka-1",
        "soka-2",
        "soka-3",
        "--stop-loss",
        "${input:stopLoss}"
      ],
      "problemMatcher": [],
      "detail": "Creates data/sokaligi_state.json. Wipes any cycle in progress."
    },
    {
      "label": "3. RUN interactive loop",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_bot.py",
        "run"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "focus": true
      },
      "detail": "Asks for this round's odds, prints the stakes, asks for results, repeats."
    },
    {
      "label": "4. Status + ledger",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_bot.py",
        "status"
      ],
      "problemMatcher": [],
      "detail": "Bankroll, stage, and realised rate vs model once 150 tickets are in."
    },
    {
      "label": "Fit stake to budget",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_math.py",
        "fit",
        "--feed",
        "shared",
        "--stages",
        "5",
        "--budget",
        "${input:budget}",
        "--step",
        "100",
        "--odds",
        "${input:oddsLeeds}",
        "${input:oddsSpurs}",
        "${input:oddsForest}"
      ],
      "problemMatcher": [],
      "detail": "Largest base stake whose whole 5-stage ladder fits the budget."
    },
    {
      "label": "Price the round",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_math.py",
        "price",
        "--odds",
        "${input:oddsLeeds}",
        "${input:oddsSpurs}",
        "${input:oddsForest}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Survival / ruin table",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_math.py",
        "ruin",
        "--feed",
        "shared",
        "--stages",
        "5",
        "--base",
        "${input:base}",
        "--bankroll",
        "${input:bankroll}",
        "--odds",
        "${input:oddsLeeds}",
        "${input:oddsSpurs}",
        "${input:oddsForest}"
      ],
      "problemMatcher": []
    },
    {
      "label": "One-shot: size next stage",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_bot.py",
        "next",
        "--odds",
        "${input:oddsLeeds}",
        "${input:oddsSpurs}",
        "${input:oddsForest}"
      ],
      "problemMatcher": [],
      "detail": "Sizes the round from the odds you type and prints what to place."
    },
    {
      "label": "One-shot: settle round",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_bot.py",
        "settle",
        "--results",
        "${input:results}"
      ],
      "problemMatcher": [],
      "detail": "One triple, e.g. YNY. Advances or resets the ladder."
    },
    {
      "label": "Abandon cycle (reset ladder)",
      "type": "shell",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "sokaligi_bot.py",
        "reset"
      ],
      "problemMatcher": [],
      "detail": "Drops the carried deficit and starts a fresh cycle at stage 1."
    }
  ],
  "inputs": [
    {
      "id": "oddsLeeds",
      "type": "promptString",
      "description": "Match 1 (Leeds) BTTS odds as yes,no",
      "default": "1.69,2.17"
    },
    {
      "id": "oddsSpurs",
      "type": "promptString",
      "description": "Match 2 (Spurs) BTTS odds as yes,no",
      "default": "1.84,1.97"
    },
    {
      "id": "oddsForest",
      "type": "promptString",
      "description": "Match 3 (N.Forest) BTTS odds as yes,no",
      "default": "1.69,2.17"
    },
    {
      "id": "results",
      "type": "promptString",
      "description": "BTTS results in match order, e.g. YNY",
      "default": "YNY"
    },
    {
      "id": "bankroll",
      "type": "promptString",
      "description": "Bankroll in TZS",
      "default": "21000"
    },
    {
      "id": "base",
      "type": "promptString",
      "description": "Stage 1 stake per slip",
      "default": "200"
    },
    {
      "id": "stopLoss",
      "type": "promptString",
      "description": "Max session drawdown in TZS",
      "default": "19800"
    },
    {
      "id": "budget",
      "type": "promptString",
      "description": "Budget the whole ladder must fit inside",
      "default": "20000"
    },
    {
      "id": "screen",
      "type": "pickString",
      "description": "Screen size, for tiling the account windows",
      "options": [
        "1920x1080",
        "1600x900",
        "1366x768",
        "2560x1440"
      ],
      "default": "1920x1080"
    }
  ]
}
