{
  "python.analysis.extraPaths": ["./short football"],
  "python.terminal.activateEnvironment": false,
  "terminal.integrated.cwd": "${workspaceFolder}/short football",
  "files.exclude": {
    "**/__pycache__": true,
    "**/profiles": true
  },
  "files.associations": {
    "*.code-workspace": "jsonc"
  },
  "editor.rulers": [88],
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
